                    subprocess.Popen([target], cwd=cwd, env=clean_env, creationflags=creationflags, close_fds=True)
                return True, "Launching Roblox."
            elif norm in ["spotify", "discord"]:
                if spec.get("target"):
                    target = spec["target"]
