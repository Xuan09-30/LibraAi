                        if os.path.isfile(candidate):
                            try:
                                mtime = os.path.getmtime(candidate)
                            except OSError:
                                mtime = 0.0
                            if mtime > newest_mtime:
                                newest_mtime = mtime
                                newest_roblox_exe = candidate
            except OSError:
                continue

        if newest_roblox_exe:
            roblox_spec = {
                "name": "Roblox",
                "launch_type": "executable",
                "target": newest_roblox_exe,
                "args": [],
                "source": "appdata_roblox",
            }
            discovered["roblox"] = roblox_spec
            discovered["roblox player"] = roblox_spec

        # 2. Discord Scanner
        discord_dir = os.path.expanduser(r"~\AppData\Local\Discord")
        if os.path.isdir(discord_dir):
            update_exe = os.path.join(discord_dir, "Update.exe")
            if os.path.isfile(update_exe):
                discovered["discord"] = {
                    "name": "Discord",
                    "launch_type": "executable",
                    "target": update_exe,
                    "args": ["--processStart", "Discord.exe"],
                    "source": "appdata_discord",
                }
            else:
                try:
                    for sub in sorted(os.listdir(discord_dir), reverse=True):
                        if sub.lower().startswith("app-"):
                            d_exe = os.path.join(discord_dir, sub, "Discord.exe")
                            if os.path.isfile(d_exe):
                                discovered["discord"] = {
                                    "name": "Discord",
                                    "launch_type": "executable",
                                    "target": d_exe,
                                    "args": [],
                                    "source": "appdata_discord",
                                }
                                break
                except OSError:
                    pass

        # 3. Spotify Scanner
        spotify_candidates = [
            os.path.expanduser(r"~\AppData\Roaming\Spotify\Spotify.exe"),
            os.path.expanduser(r"~\AppData\Local\Microsoft\WindowsApps\Spotify.exe"),
        ]
        for sp_exe in spotify_candidates:
            if os.path.isfile(sp_exe):
                discovered["spotify"] = {
                    "name": "Spotify",
                    "launch_type": "executable",
                    "target": sp_exe,
                    "args": [],
                    "source": "appdata_spotify",
                }
                break

        # 4. AppData\Local\Programs\* Scanner (VS Code, Notion, Obsidian, Cursor, Telegram, etc.)
        local_programs = os.path.expanduser(r"~\AppData\Local\Programs")
        if os.path.isdir(local_programs):
            skip_bins = ("unins", "update", "crash", "squirrel", "helper", "elevate")
            try:
                for app_folder in os.listdir(local_programs):
                    folder_path = os.path.join(local_programs, app_folder)
                    if not os.path.isdir(folder_path):
                        continue
                    try:
                        for fname in os.listdir(folder_path):
                            if not fname.lower().endswith(".exe"):
                                continue
                            if any(fname.lower().startswith(sb) for sb in skip_bins):
                                continue
                            exe_full = os.path.join(folder_path, fname)
                            base_title = os.path.splitext(fname)[0]
                            key = base_title.lower()
                            entry = {
                                "name": base_title,
                                "launch_type": "executable",
                                "target": exe_full,
                                "args": [],
                                "source": "appdata_programs",
                            }
                            discovered[key] = entry
                            discovered[app_folder.lower()] = entry
                            if key == "code":
                                discovered["visual studio code"] = entry
                                discovered["vscode"] = entry
                                discovered["vs code"] = entry
                    except OSError:
                        continue
            except OSError:
                pass

        return discovered

    def _scan_uwp_start_apps(self) -> Dict[str, Dict[str, Any]]:
        """
        Layer 2: Enumerates Windows UWP and Start Menu apps via PowerShell Get-StartApps
        and maps them to shell:AppsFolder\\{AppID} so they launch cleanly via explorer.exe
        without triggering broken Microsoft Store modals.
        """
        if GameDiscoveryEngine._UWP_CACHE is not None:
            return dict(GameDiscoveryEngine._UWP_CACHE)

        discovered: Dict[str, Dict[str, Any]] = {}
        if sys.platform != "win32":
            GameDiscoveryEngine._UWP_CACHE = discovered
            return discovered

        skip_keywords = ["uninstall", "help", "readme", "documentation", "release notes", "faqs", "manual"]
        try:
            proc = subprocess.run(
                ["powershell", "-NoProfile", "-Command", "Get-StartApps | ConvertTo-Json"],
                capture_output=True,
                text=True,
                timeout=3,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                raw_data = json.loads(proc.stdout.strip())
                items = raw_data if isinstance(raw_data, list) else [raw_data]
                for item in items:
                    if not isinstance(item, dict):
                        continue
                    raw_name = str(item.get("Name") or "").strip()
                    app_id = str(item.get("AppID") or "").strip()
                    if not raw_name or not app_id:
                        continue
                    if any(sk in raw_name.lower() for sk in skip_keywords):
                        continue
                    clean_name = re.sub(r'[®™©\xae\x99]', '', raw_name).strip()
                    if not clean_name:
                        continue
                    key = clean_name.lower()
                    entry = {
                        "name": clean_name,
                        "launch_type": "uwp",
                        "target": f"shell:AppsFolder\\{app_id}",
                        "app_id": app_id,
                        "source": "uwp_startapps",
                    }
                    discovered[key] = entry
                    if "roblox" in key and "studio" not in key:
                        discovered.setdefault("roblox", entry)
        except Exception:
            pass

        GameDiscoveryEngine._UWP_CACHE = discovered
        return dict(discovered)

    def _scan_shortcuts_and_launchers(self) -> Dict[str, Dict[str, Any]]:
        """Scans Start Menu, Desktop shortcuts (.lnk, .url), and known game clients."""
        discovered: Dict[str, Dict[str, Any]] = {}

        roots = [
            r"C:\ProgramData\Microsoft\Windows\Start Menu\Programs",
            os.path.expanduser("~/AppData/Roaming/Microsoft/Windows/Start Menu/Programs"),
            os.path.expanduser("~/Desktop"),
            os.path.expanduser("~/OneDrive/Desktop"),
            r"C:\Users\Public\Desktop",
        ]

        skip_keywords = ["uninstall", "help", "readme", "documentation", "release notes", "faqs", "manual"]

        for root in roots:
            if not os.path.isdir(root):
                continue
            for dirpath, _, filenames in os.walk(root):
                for f in filenames:
                    f_lower = f.lower()
                    if not (f_lower.endswith(".lnk") or f_lower.endswith(".url")):
                        continue

                    raw_name = os.path.splitext(f)[0]
                    if any(sk in raw_name.lower() for sk in skip_keywords):
                        continue

                    clean_name = re.sub(r'[®™©\xae\x99]', '', raw_name).strip()
                    if not clean_name:
                        continue

                    full_path = os.path.join(dirpath, f)
                    key = clean_name.lower()

                    if f_lower.endswith(".url"):
                        try:
                            with open(full_path, "r", encoding="utf-8", errors="ignore") as url_file:
                                content = url_file.read()
                            url_m = re.search(r"URL=(.+)", content)
                            if url_m:
                                target_url = url_m.group(1).strip()
                                # Never register ms-windows-store or bare roblox protocol URIs
                                if target_url.lower().startswith(("ms-windows-store:", "roblox:", "roblox-player:")):
                                    continue
                                entry = {
                                    "name": clean_name,
                                    "launch_type": "uri",
                                    "target": target_url,
                                    "source": "url_shortcut"
                                }
                                discovered[key] = entry
                                if key == "overwatch":
                                    discovered["overwatch 2"] = entry
                                continue
                        except Exception:
                            pass

                    # Default .lnk handler
                    entry = {
                        "name": clean_name,
                        "launch_type": "lnk",
                        "target": full_path,
                        "source": "lnk_shortcut"
                    }
                    discovered[key] = entry
                    if "roblox player" in key or key == "roblox":
                        discovered["roblox"] = entry

        # Dedicated Known Clients: Riot Client & Battle.net
        riot_candidates = [
            r"C:\Riot Games\Riot Client\RiotClientServices.exe",
            os.path.expandvars(r"%PROGRAMFILES%\Riot Games\Riot Client\RiotClientServices.exe"),
            os.path.expandvars(r"%LOCALAPPDATA%\Riot Games\Riot Client\RiotClientServices.exe"),
        ]
        for rc in riot_candidates:
            if os.path.isfile(rc):
                discovered["valorant"] = {
                    "name": "Valorant",
                    "launch_type": "executable",
                    "target": rc,
                    "args": ["--launch-product=valorant", "--launch-patchline=live"],
                    "source": "riot"
                }
                discovered["league of legends"] = {
                    "name": "League of Legends",
                    "launch_type": "executable",
                    "target": rc,
                    "args": ["--launch-product=league_of_legends", "--launch-patchline=live"],
                    "source": "riot"
                }
                break

        bnet_candidates = [
            r"C:\Program Files (x86)\Battle.net\Battle.net.exe",
            r"C:\Program Files\Battle.net\Battle.net.exe",
        ]
        for bc in bnet_candidates:
            if os.path.isfile(bc):
                discovered["battle.net"] = {
                    "name": "Battle.net",
                    "launch_type": "executable",
                    "target": bc,
                    "args": [],
                    "source": "battlenet"
                }
                if "overwatch" not in discovered:
                    discovered["overwatch"] = {
                        "name": "Overwatch 2",
                        "launch_type": "executable",
                        "target": bc,
                        "args": ['--exec="launch Pro"'],
                        "source": "battlenet"
                    }
                    discovered["overwatch 2"] = discovered["overwatch"]
                break

        return discovered

    def _live_everything_fallback(self, query_name: str) -> Optional[Dict[str, Any]]:
        """
        Layer 3: Live fallback search via Voidtools Everything (es.exe) for <app_name>*.exe
        or <app_name>*.lnk in Program Files, Program Files (x86), AppData\\Local, and Desktop.
        """
        if not query_name or len(query_name) < 2:
            return None

        # Only run for alphanumeric app names
        safe_token = re.sub(r"[^a-zA-Z0-9_\-\s]", "", query_name).strip()
        if not safe_token:
            return None

        es_candidates = [
            "es.exe",
            r"C:\Program Files\Everything\es.exe",
            r"C:\Program Files (x86)\Everything\es.exe",
            os.path.expanduser(r"~\AppData\Local\Microsoft\WinGet\Links\es.exe"),
        ]
        es_bin = None
        for c in es_candidates:
            if c == "es.exe":
                continue
            if os.path.isfile(c):
                es_bin = c
                break
        if not es_bin:
            es_bin = "es.exe"

        allowed_roots = (
            "program files",
            "appdata\\local",
            "appdata\\roaming",
            "desktop",
            "start menu",
        )
        skip_words = ("uninstall", "unins000", "crash", "updater", "setup", "installer", "temp")

        try:
            pattern = f"{safe_token}*.exe|{safe_token}*.lnk"
            proc = subprocess.run(
                [es_bin, "-n", "15", pattern],
                capture_output=True,
                text=True,
                timeout=2,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                for line in proc.stdout.splitlines():
                    path = line.strip()
                    p_low = path.lower()
                    if not os.path.isfile(path):
                        continue
                    if not any(r in p_low for r in allowed_roots):
                        continue
                    if any(sw in p_low for sw in skip_words):
                        continue
                    l_type = "lnk" if p_low.endswith(".lnk") else "executable"
                    entry = {
                        "name": safe_token.title(),
                        "launch_type": l_type,
                        "target": path,
                        "source": "everything_fallback",
                    }
                    self.apps[safe_token.lower()] = entry
                    return entry
        except Exception:
            pass

        return None

    def _scan_windows_utilities(self) -> Dict[str, Dict[str, Any]]:
        """Scans and registers standard Windows built-in tools and accessories."""
        discovered: Dict[str, Dict[str, Any]] = {}
        system32 = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32")

        utils = [
            ("notepad", "Notepad", "notepad.exe", "executable"),
            ("calculator", "Calculator", "calc.exe", "executable"),
            ("calc", "Calculator", "calc.exe", "executable"),
            ("paint", "Paint", "mspaint.exe", "executable"),
            ("mspaint", "Paint", "mspaint.exe", "executable"),
            ("task manager", "Task Manager", "taskmgr.exe", "executable"),
            ("taskmgr", "Task Manager", "taskmgr.exe", "executable"),
            ("command prompt", "Command Prompt", "cmd.exe", "executable"),
            ("cmd", "Command Prompt", "cmd.exe", "executable"),
            ("powershell", "PowerShell", "powershell.exe", "executable"),
            ("terminal", "Windows Terminal", "wt.exe", "executable"),
            ("windows terminal", "Windows Terminal", "wt.exe", "executable"),
            ("file explorer", "File Explorer", "explorer.exe", "executable"),
            ("explorer", "File Explorer", "explorer.exe", "executable"),
            ("control panel", "Control Panel", "control.exe", "executable"),
            ("settings", "Windows Settings", "ms-settings:", "uri"),
            ("windows settings", "Windows Settings", "ms-settings:", "uri"),
            ("snipping tool", "Snipping Tool", "snippingtool.exe", "executable"),
            ("character map", "Character Map", "charmap.exe", "executable"),
            ("disk cleanup", "Disk Cleanup", "cleanmgr.exe", "executable"),
            ("resource monitor", "Resource Monitor", "resmon.exe", "executable"),
            ("device manager", "Device Manager", "devmgmt.msc", "executable"),
            ("event viewer", "Event Viewer", "eventvwr.msc", "executable"),
            ("system information", "System Information", "msinfo32.exe", "executable"),
        ]
        for key, name, target, l_type in utils:
            if l_type == "executable" and not os.path.isabs(target) and sys.platform == "win32":
                full_target = os.path.join(system32, target)
                if not os.path.isfile(full_target):
                    full_target = shutil.which(target) or target
            else:
                full_target = target

            discovered[key] = {
                "name": name,
                "launch_type": l_type,
                "target": full_target,
                "source": "windows_utility",
            }
        return discovered

    def _scan_registry_app_paths(self) -> Dict[str, Dict[str, Any]]:
        """
        Scans HKLM and HKCU 'Software\\Microsoft\\Windows\\CurrentVersion\\App Paths'
        for system-registered application binaries (Chrome, Edge, VLC, Acrobat, etc.).
        """
        discovered: Dict[str, Dict[str, Any]] = {}
        if sys.platform != "win32":
            return discovered

        try:
            import winreg
            roots = [
                (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths"),
                (winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths"),
            ]
            for root, subkey in roots:
                try:
                    with winreg.OpenKey(root, subkey) as key:
                        count = winreg.QueryInfoKey(key)[0]
                        for i in range(count):
                            try:
                                sub = winreg.EnumKey(key, i)
                                with winreg.OpenKey(key, sub) as app_key:
                                    val, _ = winreg.QueryValueEx(app_key, "")
                                    if val and os.path.isfile(val):
                                        clean_name = os.path.splitext(sub)[0].replace("_", " ").title()
                                        key_name = clean_name.lower()
                                        entry = {
                                            "name": clean_name,
                                            "launch_type": "executable",
                                            "target": os.path.normpath(val),
                                            "args": [],
                                            "source": "registry_app_paths",
                                        }
                                        discovered[key_name] = entry
                                        discovered[sub.lower()] = entry
                                        if sub.lower().endswith(".exe"):
                                            discovered[sub.lower()[:-4]] = entry
                            except (OSError, FileNotFoundError):
                                continue
                except (OSError, FileNotFoundError):
                    continue
        except Exception:
            pass

        return discovered

    def _scan_registry_uninstall(self) -> Dict[str, Dict[str, Any]]:
        """
        Scans Windows Uninstall registry keys (HKLM, WOW6432Node, HKCU)
        to identify third-party installed software and resolve primary executables.
        """
        discovered: Dict[str, Dict[str, Any]] = {}
        if sys.platform != "win32":
            return discovered

        try:
            import winreg
            roots = [
                (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
                (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"),
                (winreg.HKEY_CURRENT_USER, r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"),
            ]
            skip_words = ("uninstall", "update", "redistributable", "sdk", "driver", "runtime", "support", "prerequisite")
            for root, subkey in roots:
                try:
                    with winreg.OpenKey(root, subkey) as key:
                        count = winreg.QueryInfoKey(key)[0]
                        for i in range(count):
                            try:
                                sub = winreg.EnumKey(key, i)
                                with winreg.OpenKey(key, sub) as app_key:
                                    try:
                                        display_name, _ = winreg.QueryValueEx(app_key, "DisplayName")
                                    except OSError:
                                        continue
                                    if not display_name or not isinstance(display_name, str):
                                        continue
                                    dn_clean = re.sub(r'[®™©\xae\x99]', '', display_name).strip()
                                    if not dn_clean or len(dn_clean) < 2:
                                        continue
                                    dn_low = dn_clean.lower()
                                    if any(sw in dn_low for sw in skip_words):
                                        continue

                                    exe_target = None
                                    # 1. Try DisplayIcon
                                    try:
                                        icon_val, _ = winreg.QueryValueEx(app_key, "DisplayIcon")
                                        if icon_val and isinstance(icon_val, str):
                                            raw_p = icon_val.split(",")[0].strip('"').strip()
                                            if raw_p.lower().endswith(".exe") and os.path.isfile(raw_p):
                                                if not any(sw in os.path.basename(raw_p).lower() for sw in skip_words):
                                                    exe_target = raw_p
                                    except OSError:
                                        pass

                                    # 2. Try InstallLocation if DisplayIcon didn't give an exe
                                    if not exe_target:
                                        try:
                                            inst_loc, _ = winreg.QueryValueEx(app_key, "InstallLocation")
                                            if inst_loc and os.path.isdir(inst_loc):
                                                for f in os.listdir(inst_loc):
                                                    if f.lower().endswith(".exe") and not any(sw in f.lower() for sw in skip_words):
                                                        cand = os.path.join(inst_loc, f)
                                                        if os.path.isfile(cand):
                                                            exe_target = cand
                                                            break
                                        except OSError:
                                            pass

                                    if exe_target:
                                        entry = {
                                            "name": dn_clean,
                                            "launch_type": "executable",
                                            "target": os.path.normpath(exe_target),
                                            "args": [],
                                            "source": "registry_uninstall",
                                        }
                                        discovered[dn_low] = entry
                                        stem = os.path.splitext(os.path.basename(exe_target))[0].lower()
                                        if stem and stem not in discovered:
                                            discovered[stem] = entry
                            except (OSError, FileNotFoundError):
                                continue
                except (OSError, FileNotFoundError):
                    continue
        except Exception:
            pass

        return discovered

    def _scan_program_files_binaries(self) -> Dict[str, Dict[str, Any]]:
        """
        Scans C:\\Program Files and C:\\Program Files (x86) top-level folders
        for primary application executables.
        """
        discovered: Dict[str, Dict[str, Any]] = {}
        if sys.platform != "win32":
            return discovered

        roots = [
            os.environ.get("ProgramFiles", r"C:\Program Files"),
            os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"),
        ]
        skip_words = ("unins", "update", "crash", "elevate", "helper", "setup", "install", "vcredist", "dotnet")

        for root in roots:
            if not root or not os.path.isdir(root):
                continue
            try:
                for app_dir in os.listdir(root):
                    folder_path = os.path.join(root, app_dir)
                    if not os.path.isdir(folder_path):
                        continue
                    if app_dir.lower() in ("common files", "windows nt", "windows defender", "windows mail", "internet explorer"):
                        continue
                    try:
                        candidates = []
                        for f in os.listdir(folder_path):
                            if f.lower().endswith(".exe") and not any(sw in f.lower() for sw in skip_words):
                                p = os.path.join(folder_path, f)
                                if os.path.isfile(p):
                                    candidates.append((f, p))

                        if not candidates:
                            for sub in os.listdir(folder_path):
                                sub_p = os.path.join(folder_path, sub)
                                if os.path.isdir(sub_p) and sub.lower() in ("bin", "app", app_dir.lower()):
                                    for f in os.listdir(sub_p):
                                        if f.lower().endswith(".exe") and not any(sw in f.lower() for sw in skip_words):
                                            p = os.path.join(sub_p, f)
                                            if os.path.isfile(p):
                                                candidates.append((f, p))

                        for fname, full_exe in candidates:
                            base_name = os.path.splitext(fname)[0]
                            clean_app = app_dir.strip()
                            entry = {
                                "name": clean_app if clean_app.lower() in fname.lower() else base_name.replace("_", " ").title(),
                                "launch_type": "executable",
                                "target": full_exe,
                                "args": [],
                                "source": "program_files",
                            }
                            discovered[base_name.lower()] = entry
                            discovered[clean_app.lower()] = entry
                    except OSError:
                        continue
            except OSError:
                continue

        return discovered

    def refresh(self):
        """Refreshes discovered apps from Windows utilities, Program Files, Registry, UWP, shortcuts, AppData, and Steam."""
        win_utils = self._scan_windows_utilities()
        prog_apps = self._scan_program_files_binaries()
        uninstall_apps = self._scan_registry_uninstall()
        reg_apps = self._scan_registry_app_paths()
        uwp_apps = self._scan_uwp_start_apps()
        shortcut_apps = self._scan_shortcuts_and_launchers()
        appdata_apps = self._scan_appdata_binaries()
        steam_apps = self._scan_steam_libraries()

        # Priority order: Utilities -> Program Files -> Registry Uninstall -> App Paths -> UWP -> Shortcuts -> AppData -> Steam
        self.apps = {}
        self.apps.update(win_utils)
        self.apps.update(prog_apps)
        self.apps.update(uninstall_apps)
        self.apps.update(reg_apps)
        self.apps.update(uwp_apps)
        self.apps.update(shortcut_apps)
        self.apps.update(appdata_apps)
        self.apps.update(steam_apps)

    def resolve_app(self, query: str) -> Optional[Dict[str, Any]]:
        """
        Resolves a user application query to a launch specification.
        1. Strips conversational commands ('launch', 'open', 'play').
        2. Resolves gaming acronyms and slang.
        3. Matches exact, condensed, substring, and fuzzy candidates (difflib).
        4. Checks system PATH via shutil.which.
        5. Queries Layer 3 Voidtools Everything (es.exe) live fallback.
        6. Provides dry-run/mock fallbacks for known core titles in test environments.
        """
        clean = query.lower().strip()
        clean = re.sub(r"^(?:please\s+)?(?:launch|open|play|start|run)\s+", "", clean).strip()
        clean = re.sub(r"\s+for\s+me$", "", clean).strip().rstrip(".?!")

        if not clean:
            return None

        # 1. Resolve via acronym map
        mapped_target = self.ACRONYM_MAP.get(clean, clean)

        GENERIC_STOP_WORDS = {
            "app", "apps", "application", "applications", "program", "programs",
            "game", "games", "window", "windows", "computer", "system", "file",
            "folder", "anything", "something", "a program", "the program",
            "a game", "the game", "an app", "the app", "any app", "any apps",
            "any program", "any programs", "all apps", "all programs", "it", "this"
        }
        if clean in GENERIC_STOP_WORDS or mapped_target in GENERIC_STOP_WORDS:
            return None

        # 2. Direct match
        if clean in self.apps:
            return self.apps[clean]
        if mapped_target in self.apps:
            return self.apps[mapped_target]

        # 3. Condensed match (ignoring spaces, hyphens, underscores)
        condensed_clean = re.sub(r'[^a-z0-9]', '', clean)
        condensed_mapped = re.sub(r'[^a-z0-9]', '', mapped_target)
        for k, v in self.apps.items():
            k_condensed = re.sub(r'[^a-z0-9]', '', k)
            if k_condensed and k_condensed in [condensed_clean, condensed_mapped]:
                return v

        # 4. Word-boundary substring match
        for k, v in self.apps.items():
            if clean == k:
                return v
            if len(clean) >= 4 and re.search(rf"\b{re.escape(clean)}\b", k):
