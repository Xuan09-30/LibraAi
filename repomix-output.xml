    plan_pronoun = llm.plan(open_pronoun_q, dry_run=True)
    print(f"  [Pronoun 'open that folder']: action='{plan_pronoun.get('action')}', folder='{plan_pronoun.get('args', {}).get('folder')}', path='{plan_pronoun.get('path')}'")
