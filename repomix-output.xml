                cfg.update(web_sec)
                if "allowed_gmail" not in cfg and "admin_email" in cfg:
                    cfg["allowed_gmail"] = cfg["admin_email"]
        except Exception as e:
            logger.warning(f"Error reading config.json for web_server: {e}")

    # Environment variable overrides
