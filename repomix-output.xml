    else:
        print(f"  [FAIL] Test 5: Clean env contains venv or python markers: venv={has_venv_var}, path={venv_in_path}")

    # Summary
    print("\n" + "=" * 65)
    score_pct = (passed / total) * 100
    print(f"Game Discovery & Folder Suite: {passed}/{total} Passed ({score_pct:.1f}%)")
