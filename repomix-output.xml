/* ==========================================================================
   PROJECT LIBRA // CYBERNETIC PWA STYLESHEET (PHASE 10)
   Gemini-Style Multi-Chat Drawer, Real-Time Token Telemetry & Cyberpunk HUD
   ========================================================================== */

:root {
  --bg-dark: #030708;
  --bg-sidebar: #060b10;
  --card-bg: rgba(10, 16, 26, 0.88);
  --card-bg-hover: rgba(18, 28, 45, 0.88);
  --border-cyan: rgba(0, 242, 254, 0.35);
  --border-subtle: rgba(255, 255, 255, 0.08);
  --neon-cyan: #00f2fe;
  --neon-cyan-glow: rgba(0, 242, 254, 0.45);
  --neon-purple: #d946ef;
  --neon-emerald: #10b981;
  --neon-amber: #f59e0b;
  --neon-red: #ef4444;
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  --sidebar-width: 280px;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* ==========================================================================
   APP SHELL LAYOUT (DRAWER + MAIN STAGE)
   ========================================================================== */
#app-layout {
  display: flex;
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

/* ==========================================================================
   LEFT SIDEBAR DRAWER (GEMINI-STYLE MULTI-CHAT)
   ========================================================================== */
#drawer-backdrop {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(4px);
  z-index: 45;
  transition: opacity 0.3s ease;
}

#drawer {
  width: var(--sidebar-width);
  height: 100%;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border-cyan);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  z-index: 50;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.drawer-header {
  padding: 16px 14px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.drawer-branding {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-title {
  font-family: 'Consolas', monospace;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: 2px;
  color: var(--neon-cyan);
  text-shadow: 0 0 10px var(--neon-cyan-glow);
}

.close-drawer-btn {
  display: none;
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
}

.new-chat-btn {
  width: 100%;
  padding: 10px 14px;
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(217, 70, 239, 0.1));
  border: 1px solid var(--neon-cyan);
  border-radius: 8px;
  color: var(--neon-cyan);
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 0 12px rgba(0, 242, 254, 0.15);
}

.new-chat-btn:hover {
  background: linear-gradient(135deg, rgba(0, 242, 254, 0.3), rgba(217, 70, 239, 0.25));
  box-shadow: 0 0 18px rgba(0, 242, 254, 0.35);
  transform: translateY(-1px);
}

.session-list-section {
  flex: 1;
  overflow-y: auto;
  padding: 10px 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.session-list-section::-webkit-scrollbar {
  width: 4px;
}
.session-list-section::-webkit-scrollbar-thumb {
  background: rgba(0, 242, 254, 0.2);
  border-radius: 2px;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  border-radius: 6px;
  color: var(--text-muted);
  font-size: 12.5px;
  cursor: pointer;
  transition: all 0.15s ease;
  position: relative;
  user-select: none;
}

.session-item:hover {
  background: var(--card-bg-hover);
  color: var(--text-main);
}

.session-item.active {
  background: rgba(0, 242, 254, 0.12);
  color: var(--neon-cyan);
  font-weight: 600;
  border-left: 3px solid var(--neon-cyan);
}

.session-title-wrap {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
}

.session-icon {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  opacity: 0.7;
}

.session-actions {
  display: none;
  align-items: center;
  gap: 4px;
  margin-left: 6px;
}

.session-item:hover .session-actions,
.session-item.active .session-actions {
  display: flex;
}

.session-action-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 3px;
  border-radius: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.session-action-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

.session-action-btn.delete-btn:hover {
  color: var(--neon-red);
}

.drawer-footer {
  padding: 12px 14px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-dim);
  font-family: monospace;
}

/* ==========================================================================
   MAIN CONTENT AREA (HEADER + ORB + CHAT + FOOTER)
   ========================================================================== */
#main-stage {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at 50% 20%, rgba(0, 242, 254, 0.03) 0%, rgba(3, 7, 8, 1) 75%);
}

/* TOP HEADER */
header {
  flex-shrink: 0;
  height: 52px;
  padding: 0 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  background: rgba(3, 7, 12, 0.92);
  backdrop-filter: blur(12px);
  z-index: 20;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.drawer-toggle-btn {
  background: none;
  border: none;
  color: var(--neon-cyan);
  padding: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  transition: background 0.15s ease;
}

.drawer-toggle-btn:hover {
  background: rgba(0, 242, 254, 0.12);
}

.header-new-chat-btn {
  background: rgba(0, 242, 254, 0.08);
  border: 1px solid rgba(0, 242, 254, 0.3);
  color: var(--neon-cyan);
  padding: 5px 10px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  font-family: inherit;
  transition: all 0.15s ease;
  white-space: nowrap;
}

.header-new-chat-btn:hover,
.header-new-chat-btn:active {
  background: rgba(0, 242, 254, 0.2);
  border-color: var(--neon-cyan);
  transform: translateY(-1px);
}

.active-thread-title {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 220px;
}

.scope-pill {
  font-size: 9px;
  font-family: monospace;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid var(--neon-emerald);
  color: var(--neon-emerald);
  padding: 2px 6px;
  border-radius: 10px;
  letter-spacing: 0.5px;
  flex-shrink: 0;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* TOKEN TELEMETRY HUD BUTTON */
.token-hud-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  background: rgba(217, 70, 239, 0.12);
  border: 1px solid var(--neon-purple);
  color: var(--neon-purple);
  padding: 4px 9px;
  border-radius: 6px;
  font-family: 'Consolas', monospace;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  letter-spacing: 0.5px;
}

.token-hud-btn:hover {
  background: rgba(217, 70, 239, 0.25);
  box-shadow: 0 0 12px rgba(217, 70, 239, 0.35);
  transform: translateY(-1px);
}

.token-hud-btn svg {
  flex-shrink: 0;
}

/* VITALS PILL */
.vitals-pill {
  font-size: 10px;
  font-family: monospace;
  color: var(--text-muted);
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 3px 8px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.vitals-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--neon-cyan);
  box-shadow: 0 0 6px var(--neon-cyan);
  animation: pulse-dot 2s infinite ease-in-out;
}
@keyframes pulse-dot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.85); } }

/* ==========================================================================
   3D CYBERNETIC ORB SECTION
   ========================================================================== */
#orb-section {
  position: relative;
  width: 100%;
  height: 180px;
  flex-shrink: 0;
  background: radial-gradient(circle at center, rgba(0, 242, 254, 0.08) 0%, rgba(3, 7, 8, 0) 70%);
  overflow: hidden;
  transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

#orb-section.collapsed {
  height: 64px;
  opacity: 0.85;
}

#orb-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  outline: none;
}

.orb-status-text {
  position: absolute;
  bottom: 6px;
  width: 100%;
  text-align: center;
  font-family: monospace;
  font-size: 9.5px;
  letter-spacing: 2px;
  color: var(--neon-cyan);
  text-transform: uppercase;
  opacity: 0.8;
  pointer-events: none;
}

/* ==========================================================================
   CHAT MESSAGING STAGE
   ========================================================================== */
#chat-container {
  flex: 1;
  overflow-y: auto;
  padding: 14px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  scroll-behavior: smooth;
}

#chat-container::-webkit-scrollbar {
  width: 6px;
}
#chat-container::-webkit-scrollbar-thumb {
  background: rgba(0, 242, 254, 0.2);
  border-radius: 3px;
}

.msg {
  max-width: 82%;
  padding: 12px 16px;
  border-radius: 14px;
  font-size: 13.5px;
  line-height: 1.55;
  word-break: break-word;
  animation: msg-in 0.25s ease-out;
}
@keyframes msg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.msg-user {
  align-self: flex-end;
  background: linear-gradient(135deg, rgba(0, 163, 204, 0.25) 0%, rgba(0, 242, 254, 0.12) 100%);
  border: 1px solid rgba(0, 242, 254, 0.4);
  color: #ffffff;
  border-bottom-right-radius: 4px;
  box-shadow: 0 4px 14px rgba(0, 242, 254, 0.1);
}

.msg-libra {
  align-self: flex-start;
  background: var(--card-bg);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: var(--text-main);
  border-bottom-left-radius: 4px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.msg-content {
  margin-bottom: 6px;
}

.msg-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  font-size: 10px;
  color: var(--text-muted);
  font-family: monospace;
}

.tool-badge {
  font-size: 9px;
  background: rgba(217, 70, 239, 0.15);
  border: 1px solid var(--neon-purple);
  color: var(--neon-purple);
  padding: 1px 5px;
  border-radius: 4px;
  text-transform: uppercase;
}

.token-badge {
  font-size: 9px;
  background: rgba(0, 242, 254, 0.12);
  border: 1px solid rgba(0, 242, 254, 0.4);
  color: var(--neon-cyan);
  padding: 1px 5px;
  border-radius: 4px;
}

/* MARKDOWN & CODE BLOCKS */
.msg-content p {
  margin-bottom: 8px;
}
.msg-content p:last-child {
  margin-bottom: 0;
}
.msg-content strong {
  color: var(--neon-cyan);
}
.msg-content code:not(pre code) {
  background: rgba(0, 242, 254, 0.12);
  color: var(--neon-cyan);
  padding: 1px 5px;
  border-radius: 4px;
  font-family: 'Consolas', monospace;
  font-size: 12px;
}

.code-block-wrap {
  position: relative;
  margin: 10px 0;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: #060b13;
  overflow: hidden;
}

.code-block-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 12px;
  background: rgba(15, 23, 42, 0.8);
  font-size: 11px;
  font-family: monospace;
  color: var(--text-dim);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.copy-code-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: var(--text-muted);
  border-radius: 4px;
  padding: 2px 7px;
  font-size: 10px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.copy-code-btn:hover {
  background: var(--neon-cyan);
  color: #030708;
  border-color: var(--neon-cyan);
}

.code-block-wrap pre {
  margin: 0;
  padding: 10px 14px;
  overflow-x: auto;
  font-family: 'Consolas', monospace;
  font-size: 12px;
  line-height: 1.45;
  color: #e2e8f0;
}

/* ==========================================================================
   INPUT BAR & CONTROLS
   ========================================================================== */
.attachment-tray {
  padding: 8px 14px 0 14px;
  background: rgba(6, 11, 19, 0.95);
  display: flex;
  align-items: center;
  z-index: 29;
}

.attachment-chip {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid rgba(0, 242, 254, 0.35);
  border-radius: 10px;
  padding: 6px 10px;
  max-width: 90%;
  animation: slide-up 0.2s ease;
}

.attachment-thumb {
  width: 38px;
  height: 38px;
  border-radius: 6px;
  background: rgba(0, 242, 254, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  color: var(--neon-cyan);
}

.attachment-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.attachment-meta {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

.attachment-name {
  font-size: 12px;
  font-weight: 600;
  color: var(--neon-cyan);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-status {
  font-size: 10px;
  color: var(--text-muted);
}

.remove-attachment-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: color 0.15s ease;
}
.remove-attachment-btn:hover {
  color: var(--neon-red);
}

#input-bar {
  flex-shrink: 0;
  padding: 10px 14px calc(10px + env(safe-area-inset-bottom, 0px)) 14px;
  background: rgba(6, 11, 19, 0.95);
  border-top: 1px solid rgba(0, 242, 254, 0.2);
  backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  gap: 8px;
  z-index: 30;
}

#attach-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  outline: none;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

#attach-btn:hover {
  background: rgba(0, 242, 254, 0.15);
  border-color: var(--neon-cyan);
  color: var(--neon-cyan);
}

#mic-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(0, 242, 254, 0.15);
  border: 1px solid var(--neon-cyan);
  color: var(--neon-cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  outline: none;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

#mic-btn:hover {
  background: rgba(0, 242, 254, 0.25);
  box-shadow: 0 0 12px rgba(0, 242, 254, 0.35);
}

#mic-btn.recording {
  background: rgba(239, 68, 68, 0.35);
  border-color: var(--neon-red);
  color: var(--neon-red);
  transform: scale(0.95);
  box-shadow: 0 0 18px rgba(239, 68, 68, 0.7);
  animation: pulse-recording 1.2s infinite ease-in-out;
}
@keyframes pulse-recording { 0%, 100% { transform: scale(0.95); } 50% { transform: scale(1.05); } }

#prompt-input {
  flex: 1;
  height: 42px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 21px;
  padding: 0 16px;
  color: #ffffff;
  font-size: 13.5px;
  outline: none;
  transition: border-color 0.2s;
}

#prompt-input:focus {
  border-color: var(--neon-cyan);
  box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
}

#send-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--neon-cyan);
  border: none;
  color: #030708;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: transform 0.15s ease, background-color 0.15s ease;
}

#send-btn:hover {
  background: #38bdf8;
  box-shadow: 0 0 12px rgba(0, 242, 254, 0.4);
}

#send-btn:active {
  transform: scale(0.92);
}

/* ==========================================================================
   TOKEN TELEMETRY BREAKDOWN MODAL (PHASE 10)
   ========================================================================== */
#token-modal.modal-overlay,
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 16px;
  z-index: 100;
  animation: fade-in 0.2s ease-out;
}
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

.modal-content {
  background: rgba(10, 16, 26, 0.95);
  border: 1px solid var(--border-cyan);
  border-radius: 14px;
  width: 100%;
  max-width: 460px;
  box-shadow: 0 0 32px rgba(0, 242, 254, 0.25);
  overflow: hidden;
  animation: scale-up 0.2s ease-out;
}
@keyframes scale-up { from { transform: scale(0.95); } to { transform: scale(1); } }

.modal-header {
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  background: rgba(15, 23, 42, 0.6);
}

.modal-header-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'Consolas', monospace;
  font-size: 13.5px;
  letter-spacing: 1px;
  color: var(--neon-purple);
  text-transform: uppercase;
}

.modal-close-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close-btn:hover {
  color: #ffffff;
}

.modal-body {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* TOKEN METRICS GRID */
.token-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.token-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.token-card-header {
  font-size: 10px;
  color: var(--text-muted);
  font-family: monospace;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.token-card-value {
  font-family: 'Consolas', monospace;
  font-size: 20px;
  font-weight: 700;
  color: var(--neon-cyan);
}

.token-card-sub {
  font-size: 10px;
  color: var(--text-dim);
  font-family: monospace;
}

.token-card.highlight {
  border-color: rgba(217, 70, 239, 0.4);
  background: rgba(217, 70, 239, 0.08);
}
.token-card.highlight .token-card-value {
  color: var(--neon-purple);
}

.token-card.savings {
  grid-column: span 2;
  border-color: rgba(16, 185, 129, 0.4);
  background: rgba(16, 185, 129, 0.08);
}
.token-card.savings .token-card-value {
  color: var(--neon-emerald);
}

/* ==========================================================================
   AUTHENTICATION MODAL
   ========================================================================== */
#auth-modal .modal-content {
  max-width: 360px;
  padding: 24px;
}

.auth-title {
  font-family: monospace;
  color: var(--neon-cyan);
  font-size: 14px;
  letter-spacing: 1.5px;
  margin-bottom: 10px;
}

.auth-desc {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 16px;
  line-height: 1.45;
}

.auth-input {
  width: 100%;
  padding: 10px 12px;
  background: rgba(3, 7, 12, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 6px;
  color: #ffffff;
  font-size: 13px;
  margin-bottom: 16px;
  outline: none;
}
.auth-input:focus {
  border-color: var(--neon-cyan);
}

.auth-btn {
  width: 100%;
  padding: 10px;
  background: var(--neon-cyan);
  border: none;
  border-radius: 6px;
  color: #030708;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.15s ease;
}
.auth-btn:hover {
  background: #38bdf8;
}

/* MODAL PROMPT & ACTION BUTTONS (DELETE & RENAME) */
.modal-prompt-text {
  font-size: 13px;
  color: var(--text-main);
  margin-bottom: 20px;
  line-height: 1.5;
}

.modal-action-row {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

.modal-btn {
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
  border: 1px solid transparent;
  font-family: inherit;
}

.modal-btn.primary {
  background: var(--neon-cyan);
  color: #030708;
}
.modal-btn.primary:hover {
  background: #38bdf8;
}

.modal-btn.danger {
  background: #ef4444;
  color: #ffffff;
}
.modal-btn.danger:hover {
  background: #dc2626;
}

.modal-btn.secondary {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
  border-color: rgba(255, 255, 255, 0.15);
}
.modal-btn.secondary:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.text-danger {
  color: #ef4444 !important;
}

/* INLINE AUDIO REPLAY BADGE */
.replay-audio-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(0, 242, 254, 0.12);
  border: 1px solid rgba(0, 242, 254, 0.35);
  color: var(--neon-cyan);
  border-radius: 12px;
  padding: 3px 9px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
  margin-left: 6px;
  vertical-align: middle;
}
.replay-audio-btn:hover,
.replay-audio-btn:active {
  background: rgba(0, 242, 254, 0.28);
  transform: scale(1.04);
}

/* CHAT MESSAGE ATTACHMENTS (IMAGES & DOCUMENTS) */
.msg-attachment-wrap {
  margin-bottom: 8px;
}

.msg-img-preview {
  max-width: 280px;
  max-height: 220px;
  border-radius: 8px;
  border: 1px solid rgba(0, 242, 254, 0.3);
  cursor: pointer;
  display: block;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.msg-img-preview:hover {
  transform: scale(1.02);
  box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
}

.msg-doc-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(0, 242, 254, 0.3);
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 12px;
  color: var(--neon-cyan);
  font-weight: 500;
}

.msg-doc-chip svg {
  flex-shrink: 0;
}

.msg-generated-plot {
  max-width: 100%;
  border-radius: 8px;
  border: 1px solid rgba(0, 242, 254, 0.4);
  margin-top: 10px;
  cursor: pointer;
