{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Libra Design Tokens",
  "version": "1.0.0",
  "colors": {
    "dark": {
      "bg_app": "#09090b",
      "bg_surface": "#121215",
      "bg_card": "#18181b",
      "bg_card_hover": "#222226",
      "bg_bubble_user": "#27272a",
      "bg_scrim": "rgba(0, 0, 0, 0.75)",
      "border_subtle": "rgba(255, 255, 255, 0.08)",
      "border_medium": "rgba(255, 255, 255, 0.14)",
      "border_hover": "rgba(255, 255, 255, 0.24)",
      "border_focus": "rgba(56, 189, 248, 0.6)",
      "accent_cyan": "#38bdf8",
      "accent_cyan_glow": "rgba(56, 189, 248, 0.15)",
      "accent_emerald": "#34d399",
      "accent_emerald_glow": "rgba(52, 211, 153, 0.15)",
      "accent_amber": "#fbbf24",
      "accent_amber_glow": "rgba(251, 191, 36, 0.15)",
      "accent_purple": "#c084fc",
      "accent_purple_glow": "rgba(192, 132, 252, 0.15)",
      "accent_rose": "#fb7185",
      "accent_rose_glow": "rgba(251, 113, 133, 0.15)",
      "text_primary": "#f8fafc",
      "text_secondary": "#cbd5e1",
      "text_muted": "#94a3b8",
      "text_dim": "#64748b"
    },
    "light": {
      "bg_app": "#f8fafc",
      "bg_surface": "#ffffff",
      "bg_card": "#f1f5f9",
      "bg_card_hover": "#e2e8f0",
      "bg_bubble_user": "#e2e8f0",
      "bg_scrim": "rgba(15, 23, 42, 0.45)",
      "border_subtle": "rgba(0, 0, 0, 0.08)",
      "border_medium": "rgba(0, 0, 0, 0.14)",
      "border_hover": "rgba(0, 0, 0, 0.24)",
      "border_focus": "rgba(2, 132, 199, 0.6)",
      "accent_cyan": "#0284c7",
      "accent_cyan_glow": "rgba(2, 132, 199, 0.12)",
      "accent_emerald": "#059669",
      "accent_emerald_glow": "rgba(5, 150, 105, 0.12)",
      "accent_amber": "#d97706",
      "accent_amber_glow": "rgba(217, 119, 6, 0.12)",
      "accent_purple": "#9333ea",
      "accent_purple_glow": "rgba(147, 51, 234, 0.12)",
      "accent_rose": "#e11d48",
      "accent_rose_glow": "rgba(225, 29, 72, 0.12)",
      "text_primary": "#0f172a",
      "text_secondary": "#334155",
      "text_muted": "#64748b",
      "text_dim": "#94a3b8"
    }
  },
  "typography": {
    "font_sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Inter', sans-serif",
    "font_mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "scale": {
      "2xs": { "size": "10px", "line_height": "14px" },
      "xs": { "size": "11px", "line_height": "16px" },
      "sm": { "size": "13px", "line_height": "18px" },
      "base": { "size": "14px", "line_height": "20px" },
      "md": { "size": "16px", "line_height": "24px" },
      "lg": { "size": "18px", "line_height": "26px" },
      "xl": { "size": "22px", "line_height": "28px" }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 3px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 14px rgba(0, 0, 0, 0.45)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.65)",
    "modal": "0 24px 60px rgba(0, 0, 0, 0.85)"
  },
  "motion": {
    "fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
    "normal": "250ms cubic-bezier(0.4, 0, 0.2, 1)",
    "slow": "350ms cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "target_min": "44px"
}
